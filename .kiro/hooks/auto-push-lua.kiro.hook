{
  "enabled": true,
  "name": "Auto Push on Lua Save",
  "description": "Whenever a .lua file is saved, stages all changes, commits with a timestamp, and pushes to origin main.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.lua"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "git add -A && git commit -m \"auto: update lua files\" && git push origin master 2>&1"
  }
}